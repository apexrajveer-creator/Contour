{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Contour",
  "version": "1.0.0",
  "identifier": "studio.contour.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Contour",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "dragDropEnabled": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "On-device vocal and instrument stem separation",
    "longDescription": "Contour separates songs into vocals, lead and backing vocals, drums, bass, guitar, piano and more using MDX-Net and HT-Demucs models running locally on your CPU or GPU. Your audio never leaves your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "contour"
        ],
        "name": "Contour project",
        "description": "Contour project",
        "role": "Editor",
        "mimeType": "application/x-contour-project"
      }
    ]
  }
}